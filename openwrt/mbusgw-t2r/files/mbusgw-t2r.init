#!/bin/sh /etc/rc.common
#
#	mbusgw-t2r: the MODBUS TCP to RTU gateway under procd. Disabled until
#	'uci set mbusgw-t2r.main.enabled=1': the settings file has to be tuned first.
#	The messages go to the system log (logread -e mbusgw-t2r).

USE_PROCD=1
START=95
STOP=10

start_service() {
	local enabled settings

	config_load mbusgw-t2r
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get settings main settings /etc/mbusgw-t2r/modbus-t2r_settings.conf

	procd_open_instance
	procd_set_param command /usr/sbin/mbusgw-t2r --settings="$settings"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger mbusgw-t2r
}
