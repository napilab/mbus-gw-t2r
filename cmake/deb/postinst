#!/bin/sh
#	mbusgw-t2r: the unit is installed disabled - the settings file has to be tuned first;
#	an already running service is restarted with the new binary.
set -e
if [ "$1" = "configure" ] && [ -d /run/systemd/system ]; then
	systemctl daemon-reload || true
	if systemctl is-active --quiet mbusgw-t2r.service; then
		systemctl restart mbusgw-t2r.service || true
	fi
fi
exit 0
